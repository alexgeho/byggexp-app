{
  "name": "tot-bygghub-mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "expo start --localhost",
    "start:lan": "expo start",
    "android": "expo run:android",
    "ios": "node scripts/run-ios-simulator.js",
    "ios:18.2": "yarn ios",
    "ios:se": "node scripts/run-ios-simulator.js se",
    "ios:15": "node scripts/run-ios-simulator.js 15",
    "ios:16": "node scripts/run-ios-simulator.js 16",
    "web": "expo start --web",
    "lint": "eslint .",
    "compile": "node scripts/check-compile.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:i18n": "node scripts/check-i18n-parity.js",
    "verify": "yarn lint && yarn compile && yarn test:i18n && yarn test",
    "format": "prettier --write .",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/oswald": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/checkbox": "^0.5.20",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "@react-navigation/stack": "^7.4.10",
    "@sentry/react-native": "~7.2.0",
    "axios": "^1.13.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~54.0.34",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^15.0.7",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.9",
    "i18next": "^26.3.6",
    "jwt-decode": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "private": true,
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^15",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-file-system",
        "expo-font",
        "@react-native-community/slider",
        "react-native-webview"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@react-native-community/checkbox",
          "react-native-vector-icons"
        ]
      }
    }
  }
}
