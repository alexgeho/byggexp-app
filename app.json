{
  "expo": {
    "name": "ByggExp",
    "slug": "byggexp",
    "scheme": "byggexp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.byggexp.app",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "se.byggexp.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./scr/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ByggExp to access your photos so you can upload an avatar or attach shift images.",
          "cameraPermission": "Allow ByggExp to use your camera so you can take shift photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ByggExp to access your location while creating a project."
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ByggExp to use your camera to scan tool QR codes."
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "e64be0f7-ffc0-440c-8c72-5cffe89943b7"
      }
    }
  }
}
