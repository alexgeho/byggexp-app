{
  "expo": {
    "name": "ByggExp",
    "slug": "byggexp",
    "scheme": "byggexp",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5FA4E7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.totbygghubmobileapp",
      "buildNumber": "180",
      "associatedDomains": ["applinks:api.byggexp.se"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#54B2EC"
      },
      "edgeToEdgeEnabled": true,
      "package": "se.byggexp.app",
      "versionCode": 22,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.byggexp.se",
              "pathPrefix": "/app/magic"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ByggExp to access your photos so you can upload an avatar or attach shift images.",
          "cameraPermission": "Allow ByggExp to use your camera so you can take shift photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ByggExp to access your location while creating a project (to pre-fill the address) and when starting a work shift (to confirm you are at the project site).",
          "locationAlwaysAndWhenInUsePermission": "ByggExp automatically starts and ends your work shift when you arrive at and leave the project site, so you never forget to clock in or out — even when the app is closed. It only detects whether you are inside or outside the site's area; your exact location is not tracked or stored.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ByggExp to use your camera to take shift photos, scan receipts and tool QR codes."
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "e64be0f7-ffc0-440c-8c72-5cffe89943b7"
      }
    },
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/e64be0f7-ffc0-440c-8c72-5cffe89943b7",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    }
  }
}
